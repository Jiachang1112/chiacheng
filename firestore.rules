rules_version = '2';

// 使用方式：
// 1. 把下面 ADMIN_EMAILS 裡的信箱換成可以登入後台的帳號（可以放 1～3 個以上，一律小寫）。
//    這些信箱也要先在 Firebase 主控台 → Authentication 建立成 Email／密碼帳號。
// 2. 打開 Firebase 主控台 → Firestore Database → 規則，整份貼上後按「發布」
service cloud.firestore {
  match /databases/{database}/documents {

    // 只有這幾個帳號可以寫入（Firebase 會把信箱轉成小寫，所以這裡也要用小寫）
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'you@example.com',
          'second-admin@example.com'
        ];
    }

    // 網站內容：任何人都能讀（前台要用），只有管理員能改
    match /portfolio/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 舊版後台的連結集合：公開讀取，只有管理員能改
    match /links/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 發布紀錄：只有管理員看得到
    match /portfolio_history/{doc} {
      allow read, write: if isAdmin();
    }

    // 訪客留言：任何人都可以送出（限制欄位與長度），只有管理員能讀、標記、刪除
    match /messages/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // 其他一律不開放
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
